# Startup setting: always required to locate the database.
DATABASE_PATH=./data/lockinder.db
# The settings below are imported ONCE by migration 0004_app_settings.sql.
# After migration, edit them in /admin -> Settings. Environment changes do not
# overwrite the saved database values, including intentionally cleared secrets.
APP_URL=http://localhost:3000
# Comma-separated SteamID64 values allowed to access /admin.
# Set at least one administrator BEFORE the first settings migration.
ADMIN_STEAM_IDS=
# Optional for login itself; needed to fetch your Steam display name and avatar.
STEAM_API_KEY=
# Optional; public Deadlock endpoints work without a key.
DEADLOCK_API_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Discord user ID of the administrator who receives complaints from the site.
DISCORD_ADMIN_USER_ID=
DISCORD_GUILD_ID=
DISCORD_INVITE_URL=
